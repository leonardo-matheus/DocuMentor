# ===========================================
# DocuMentor - Environment Variables
# ===========================================
# Copie este arquivo para .env e preencha os valores

# Git (Repositório de código) - GitHub, GitLab, Gitea, etc.
GITEA_URL=https://github.com
GITEA_TOKEN=seu_token_aqui

# Claude AI (Azure AI Foundry ou Anthropic API)
AZURE_AI_ENDPOINT=https://api.anthropic.com/v1/messages
AZURE_AI_API_KEY=sua_chave_api_aqui
AZURE_AI_MODEL=claude-sonnet-4-20250514
AZURE_AI_MAX_TOKENS=16384
AZURE_AI_TEMPERATURE=0.2

# Database (SQLite)
DATABASE_URL=file:./prisma/documentor.db

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# MCP Server (opcional)
MCP_SERVER_PORT=3002
