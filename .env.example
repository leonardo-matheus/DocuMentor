# ===========================================
# DocuMentor - Environment Variables
# ===========================================
# Copie este arquivo para .env e preencha os valores

# Git (Repositório de código) - GitHub, GitLab, Gitea, etc.
GITEA_URL=https://github.com
GITEA_TOKEN=seu_token_aqui

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_KEY=sua_chave_api_aqui
AZURE_OPENAI_DEPLOYMENT=o1
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_MAX_TOKENS=16384
AZURE_OPENAI_TEMPERATURE=1

# Database (SQLite)
DATABASE_URL=file:./prisma/documentor.db

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# MCP Server (opcional)
MCP_SERVER_PORT=3002
