// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id            String   @id @default(cuid())
  name          String
  description   String?
  repositoryUrl String
  status        String   @default("draft") // draft, generating, complete
  sections      String?  // JSON array of sections
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sectionsList  Section[] @relation(name: "ProjectSections")
  metadata      ProjectMetadata?
  versions      ProjectVersion[] @relation(name: "ProjectVersions")
  additionalRepos AdditionalRepository[] @relation(name: "ProjectAdditionalRepos")
  gitSyncs      GitSync[] @relation(name: "ProjectGitSyncs")
  publications  Publication[] @relation(name: "ProjectPublications")
}

model AdditionalRepository {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, name: "ProjectAdditionalRepos")
  
  name          String   // Nome do repositório (ex: "Backend API", "Mobile App")
  repositoryUrl String
  description   String?  // Descrição da integração/papel deste repo
  languages     String?  // JSON array de linguagens detectadas
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
}

model ProjectVersion {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, name: "ProjectVersions")
  
  version     Int      // Auto-increment per project
  message     String   // Commit message
  sections    String   // JSON snapshot of all sections
  createdAt   DateTime @default(now())
  createdBy   String?  // Optional user identifier
  
  @@index([projectId])
  @@unique([projectId, version])
}

model ProjectMetadata {
  id           String   @id @default(cuid())
  projectId    String   @unique
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  languages    String   // JSON array
  frameworks   String   // JSON array
  structure    String   // JSON array of file structure
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Section {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, name: "ProjectSections")
  
  type      String   // hero, overview, architecture, flow, faq, etc.
  title     String
  content   String   // JSON content
  order     Int
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  content     String   // JSON template content
  isDefault   Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIPrompt {
  id          String   @id @default(cuid())
  sectionType String   @unique // hero, overview, architecture, etc.
  systemPrompt String
  userPromptTemplate String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GitSync {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, name: "ProjectGitSyncs")
  
  commitSha     String   // SHA do último commit sincronizado
  commitMessage String   // Mensagem do commit
  commitAuthor  String   // Autor do commit
  commitDate    DateTime // Data do commit no Gitea
  branch        String   @default("master")
  
  releaseNotes  String?  // Release notes geradas pela IA
  version       String?  // Versão semântica sugerida (ex: 1.2.0)
  
  createdAt     DateTime @default(now())
  
  @@index([projectId])
  @@unique([projectId, commitSha])
}

// ===== PUBLICATION SYSTEM =====

model Category {
  id          String   @id @default(cuid())
  name        String   @unique // ex: "Estacionamento", "Financeiro"
  slug        String   @unique // ex: "estacionamento"
  description String?
  icon        String?  // Emoji ou ícone
  color       String?  // Cor de fundo do card
  order       Int      @default(0)
  
  publications Publication[] @relation(name: "CategoryPublications")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Publication {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, name: "ProjectPublications")
  
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], name: "CategoryPublications")
  
  slug        String   @unique // URL amigável: "dionisio", "hermes"
  title       String   // Nome exibido
  description String?  // Descrição curta
  icon        String?  // Emoji ou ícone
  version     String?  // Versão publicada
  
  content     String   // Snapshot JSON das seções no momento da publicação
  
  isPublic    Boolean  @default(true)
  order       Int      @default(0) // Ordem dentro da categoria
  
  publishedAt DateTime @default(now())
  publishedBy String?  // Quem publicou
  updatedAt   DateTime @updatedAt
  
  @@index([projectId])
  @@index([categoryId])
  @@index([slug])
}
